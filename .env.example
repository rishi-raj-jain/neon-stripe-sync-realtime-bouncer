# ── Written by `neon deploy` / `neon env pull` (don't hand-edit) ───────────────
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL,
# NEON_AI_GATEWAY_TOKEN, NEON_AI_GATEWAY_BASE_URL, NEON_FUNCTION_API_BASE_URL,
# NEON_FUNCTION_TOPUPS_BASE_URL

# ── Yours ─────────────────────────────────────────────────────────────────────
# Session cookie signing for Neon Auth (openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=
# Test-mode key of the Stripe account whose pipeline syncs into this project.
# neon.ts also passes it to the `topups` function on deploy.
STRIPE_SECRET_KEY=sk_test_
# Checkout success/cancel URLs (falls back to the Vercel URL when deployed)
APP_URL=http://localhost:3000

# Optional: serve the API on your own domain (read by neon.ts at deploy time) and show that
# URL in the dashboard instead of NEON_FUNCTION_API_BASE_URL.
# API_CUSTOM_DOMAIN=api.yourdomain.com
# API_BASE_URL=https://api.yourdomain.com

# ── Demo account (Try the demo account button) ─────────────────────────────────
DEMO_USERNAME=Phoenix
DEMO_PASSWORD=
# Prefilled in Stripe Checkout for the demo account (default demo@example.com)
# DEMO_EMAIL=demo@example.com

# ── Tooling ───────────────────────────────────────────────────────────────────
# npm run og: path to Chrome/Chromium if it isn't in /Applications
# CHROME_PATH=
